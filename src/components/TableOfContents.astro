---
import TableOfContentsList from './TableOfContentsList.astro';

const { toc } = Astro.locals.starlightRoute;
---

{
	toc && (
		<starlight-toc data-min-h={toc.minHeadingLevel} data-max-h={toc.maxHeadingLevel}>
			<nav aria-labelledby="starlight__on-this-page">
				{/* 用 p + role=heading 代替 h2：目录标题不该占用页面的 H2 层级，
				    否则爬虫会把「本页内容」当成正文第一个小标题。 */}
				<p class="sl-toc-title" role="heading" aria-level="2" id="starlight__on-this-page">
					{Astro.locals.t('tableOfContents.onThisPage')}
				</p>
				<TableOfContentsList toc={toc.items} />
			</nav>
		</starlight-toc>
	)
}

<style>
	.sl-toc-title {
		color: var(--sl-color-white);
		font-size: var(--sl-text-h5);
		font-weight: 600;
		line-height: var(--sl-line-height-headings);
		margin-bottom: 0.5rem;
	}
</style>

<script src="../scripts/starlight-toc.ts"></script>
